# ============================================================
# my_agent 环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# ============================================================

# ---- LLM 配置 ----
# 支持任何兼容协议的 API（chat/completions 风格），供应商任选
#
# 选端点是"可用性"的取舍：同一个模型换端点，延迟与限流差别很大：
#   · 公网端点（官方 plan，常见零定价）：能答时 2-7s，但免费档限流较硬，
#     连续多轮长任务容易撞 429（撞上会按 LLM_MAX_RETRIES 退避）。
#   · 自建/内网网关（需网络可达）：亚秒级、不计费不限流。
# 公网端点任何网络可达；自建网关快而不限流但依赖那条网络。两者都能配，按场景选。
#
# 示例（第三方网关的推理模型）：
#   LLM_API_KEY=sk-xxxx
#   LLM_BASE_URL=https://<网关域名>/v1
#   LLM_DEFAULT_MODEL=<模型 id>
#   注意：模型页面的网址不是 API 地址，API 地址统一是 {base_url}/v1
#
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://<你的端点>/v1
LLM_DEFAULT_MODEL=<模型 id>
LLM_DEFAULT_TEMPERATURE=0.7
# ⚠️ 思考模型的**推理 token 也算在这个额度里**：给太小（如 60）会被推理吃光，
#    表现为正文空串 + finish_reason=length。主模型是思考模型时别低于 2048。
LLM_DEFAULT_MAX_OUTPUT_TOKENS=4096
# 固定温度：某些 thinking 模型只接受特定值（如必须为 1）。
# 留空=自动适配（内置规则）；也可显式指定强制值。
LLM_FIXED_TEMPERATURE=
# 限流/网络错误自动重试次数与基础退避秒数（撞 429 时靠它熬过去）
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=2.0

# ---- 上下文压缩（长对话自动把旧历史总结成摘要）----
COMPACT_ENABLED=true
# 消息总字符数阈值：超过则触发压缩（约等于 token×3）
# COMPACT_TOKEN_THRESHOLD=45000
# ↑ 别默认写死：config.py 的默认是 0 = 按网关窗口×比例**自动**算阈值。
#   显式给 45000 会短路掉自适应，1M 窗口的模型在 4.5% 处就开始丢历史。
#   想手动控制再取消注释（详见文件后半段的说明）。
# 保留最近多少条不压缩
COMPACT_KEEP_LAST=20

# ---- 浏览器配置 ----
BROWSER_HEADLESS=false

# ---- 外部 ACP 运行时用的模型 ----
# 默认走网关实际服务的模型（避免网关未知模型 503）。可改用其它网关可用模型；
# 若该模型自带视觉，视觉子系统也能直接复用它。
MY_AGENT_ACP_MODEL=<模型 id>
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# ---- 视觉配置 ----
VISION_ENABLED=true
# 视觉模型：留空自动选择。视觉可走独立端点：
#   VISION_API_KEY=          # 留空回退主 LLM 的 key
#   VISION_BASE_URL=         # 留空回退主 LLM 的地址
#   VISION_MODEL=            # 留空自动检测
# 主模型是慢推理模型时，建议用独立的多模态快模型。
#
# 选型要点（都以"答案已知的图"打过一次）：
#   · 首选自带视觉的主力模型——`GET /models` 的 input_modalities 不可信，
#     有模型标 ["text"] 其实能读图，别只看元数据；
#   · 多图（视频抽帧）场景要求模型声明并实测支持 text,image；
#   · 认字任务避开中文 OCR 不稳的模型；延迟波动大的只当跨提供方备用。
# ⚠️ 备用端点与主端点不同时，key 必须各自显式给：留空是"跟随主 LLM"，会变成拿
#    A 家 key 打 B 家端点（401）——`my-agent --doctor` 的「子系统模型对账」会核对。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_SCREENSHOT_PATH=./screenshots

# ---- 图像生成（文生图）----
# 兼容协议端点：POST {IMAGE_GEN_BASE_URL}/images/generations
# 模型填供应商文档里的生图模型 id；信息图场景可另配加速版模型
IMAGE_GEN_ENABLED=true
IMAGE_GEN_API_KEY=            # 留空回退主 LLM 的 key
IMAGE_GEN_BASE_URL=https://<你的端点>/v1
IMAGE_GEN_MODEL=<生图模型 id>
IMAGE_GEN_SIZE=1024x1024      # 1024x1024 / 768x1024 / 1024x768 / 1280x720 / 720x1280
IMAGE_GEN_SAVE_DIR=./generated_images
IMAGE_GEN_TIMEOUT=120
IMAGE_GEN_WATERMARK=false     # 供应商专有字段：不支持的端点会自动跳过

# ---- 视频生成（异步任务：创建 → 轮询 → 下载）----
# 创建 POST {base_url}/videos → 轮询 GET {query_base}/<查询路径>?video_id=... → 下载 mp4
# 注：查询端点在 HOST 根路径（不在 /v1 下），由 VIDEO_GEN_QUERY_BASE 指定或自动推导
VIDEO_GEN_ENABLED=true
VIDEO_GEN_API_KEY=              # 留空复用主 LLM key
VIDEO_GEN_BASE_URL=https://<你的端点>/v1
VIDEO_GEN_QUERY_BASE=           # 留空由 BASE_URL 去掉 /v1 推导
VIDEO_GEN_MODEL=<视频模型 id>
VIDEO_GEN_SECONDS=5             # 视频时长（秒）
# 供应商合法时长区间（秒）：越界自动 clamp（默认 [4,12]）
# VIDEO_GEN_SECONDS_MIN=4
# VIDEO_GEN_SECONDS_MAX=12
VIDEO_GEN_SIZE=720P             # 部分模型仅支持 720P
VIDEO_GEN_ASPECT_RATIO=16:9
VIDEO_GEN_SAVE_DIR=./generated_videos
VIDEO_GEN_TIMEOUT=120           # 单次 HTTP 请求超时
VIDEO_GEN_MAX_WAIT=240          # 工具内等待上限（秒）；超时返回 task_id 稍后用 status 取
VIDEO_GEN_POLL_INTERVAL=6       # 轮询间隔

# ---- 外部短剧工厂服务（可选：agent 通过它的 REST API 驱动）----
# 独立的开源短剧生产工具，后端是本地 Express 服务（默认 127.0.0.1:10588）——
# 启动其桌面端后该端口即可用；完整流程见 docs/TOONFLOW_SETUP.md。
# ⚠️ 仅限本机使用：默认账号 admin/admin123 且密码明文比对，暴露到局域网前先改密码。
TOONFLOW_ENABLED=true
TOONFLOW_BASE_URL=http://127.0.0.1:10588
TOONFLOW_USERNAME=admin
TOONFLOW_PASSWORD=admin123
TOONFLOW_TIMEOUT=60
TOONFLOW_MAX_CHARS=6000          # 单次回给模型的 JSON 字符上限

# ---- 知乎数据开放平台（可选：让 agent 检索知乎/直答/读创作数据/知识库）----
# 文档 https://developer.zhihu.com/docs ；Access Secret 在「个人中心」获取：
#   https://developer.zhihu.com/profile
# 鉴权 = Authorization: Bearer <secret> + X-Request-Timestamp(秒级 Unix 时间戳，
# 与服务端相差不得超过 10 分钟；本机时钟漂移时客户端会自动纠正并重试一次)。
# 额度按能力独立计（每自然日限免），用 zhihu 工具 quota 命令可实时查：
#   全网搜索 5000 / 知乎搜索 5000 / 用户数据 10000 / 知识库 500
#   热榜 100 / 问题回答 100 / 创作能力 100 / 直答 100 / 小工具 10
ZHIHU_ENABLED=true
ZHIHU_ACCESS_SECRET=            # 必填；不填则工具会给出配置指引
ZHIHU_BASE_URL=https://developer.zhihu.com
ZHIHU_TIMEOUT=30                # 普通读接口超时（秒）
ZHIHU_LLM_TIMEOUT=180           # 直答（大模型生成）超时
ZHIHU_UPLOAD_TIMEOUT=300        # 文件上传/产物下载超时
ZHIHU_TASK_TIMEOUT=600          # PDF 解析 / PPT 生成等异步任务的总等待上限
ZHIHU_POLL_INTERVAL=3           # 异步任务轮询间隔
ZHIHU_MAX_CHARS=12000           # 单次回给模型的字符上限
ZHIHU_SAVE_DIR=output/zhihu     # PDF 解析结果 / PPT 成品的落盘目录

# ---- 语音合成 / 配音（多供应商）----
# 用途：漫剧/短视频配音；先用 tts 出音频，再用 video_edit 的 add_audio 合到画面
TTS_ENABLED=true
# 供应商（取值即下面两个名字）：
#   edge       = 在线免费语音（免 key、中文多音色，默认）
#   openrouter = 第三方网关的 /audio/speech 兼容端点，可挂各家 TTS 模型
TTS_PROVIDER=edge

# --- 以下仅在 TTS_PROVIDER=edge 时生效 ---
TTS_VOICE=xiaoxiao              # 音色别名：女声/男声/解说等，见 models/tts.py 的映射
TTS_RATE=+0%                    # 语速，如 +20%
TTS_VOLUME=+0%
TTS_SAVE_DIR=./generated_audio

# --- 以下仅在 TTS_PROVIDER=openrouter 时生效 ---
# key：留空则回退读 OPENROUTER_API_KEY
TTS_OPENROUTER_API_KEY=
TTS_OPENROUTER_BASE_URL=https://<第三方网关>/v1
# 常用 TTS 模型（按字符计费，部分带 :free 免费变体）
#   <语音模型 id>   免费档：多语言、表现力强
#   <语音模型 id>   付费档：账户需有余额，支持声音克隆
#   <语音模型 id>   便宜快速，中文音色多
TTS_MODEL=<语音模型 id>
TTS_RESPONSE_FORMAT=mp3         # mp3（默认）/ pcm
# 归属头（可选）：只用于网关的用量榜单统计，不影响请求结果
TTS_OPENROUTER_REFERER=         # 你的站点/仓库地址，如 https://github.com/you/repo
TTS_OPENROUTER_TITLE=my_agent   # 应用名
# 网关专用音色（留空＝用模型内置默认音色；别填 edge 的音色别名，上游会报 Invalid voice）
TTS_OPENROUTER_VOICE=
# 声音克隆（模型支持时生效）：参考音频 + 其文字稿
TTS_REFERENCE_AUDIO=
TTS_REFERENCE_TEXT=
# 角色声线库（多角色配音用，优先级高于上面的全局参考）：一个目录，
# 里面每个文件 = 一个角色的克隆参考样本，命名 {角色名}.wav|mp3。
# 合成时 tts 传 voice=角色名 即自动绑定该样本 → 同角色音色恒定不偏移。
# 例：TTS_REFERENCE_DIR=./output/voice_clone_demo/role_refs
#   （内含 linshen.wav / hugong.wav / laotaitai.wav / girl.wav / narration.wav）
TTS_REFERENCE_DIR=
# 第三方网关失败时自动回退本地兜底 TTS（在线免费档不保证可用性）。
# 降级音色按角色走内置映射 ROLE_FALLBACK_VOICES（models/tts.py）：
#   narration→yunjian / linshen→yunxi / hugong→xiaoxiao /
#   laotaitai→xiaoxiao(-25%) / girl→xiaoyi；不在表里的角色用默认音色。
TTS_FALLBACK_EDGE=true

# ---- 视频剪辑（ffmpeg：图→运镜、拼接、配音合成、字幕）----
# "图 + 运镜 + 配音"路线：不消耗视频生成配额、画面可控（适合漫剧/图文视频）
# 依赖 ffmpeg/ffprobe：winget install --id Gyan.FFmpeg -e --source winget
VIDEO_EDIT_ENABLED=true
VIDEO_EDIT_WIDTH=1280           # 统一输出规格（保证片段可无损拼接）
VIDEO_EDIT_HEIGHT=720
VIDEO_EDIT_FPS=25
VIDEO_EDIT_SAVE_DIR=./generated_videos
VIDEO_EDIT_TIMEOUT=600          # 单次 ffmpeg 处理超时（拼接/重编码较久）
FFMPEG_PATH=                    # 留空自动探测 PATH / winget 安装位置

# ---- Windows 控制台防卡 ----
# **旧版 conhost** 的 QuickEdit 选区状态会永久阻塞程序 stdout（表现为"跑着跑着
# 卡死、CPU 为 0、日志停住"）。true = 启动时关闭 QuickEdit（退出时恢复）。
# 现代终端（Windows Terminal / VS Code / ConEmu）选区不阻塞 stdout，程序会
# **自动跳过**，保留鼠标选择与复制粘贴能力——所以开着本项也不影响这些终端。
MY_AGENT_DISABLE_QUICKEDIT=false

# ---- 记忆配置 ----
MEMORY_DB_PATH=./memory

# ---- 日志配置 ----
LOG_LEVEL=INFO

# ---- 审批与沙箱（借鉴同类实现 approval_policy，沙箱命名与上游一致）----
# 审批策略: untrusted / on-failure / on-request / never
APPROVAL_POLICY=on-failure
# 沙箱等级: read-only / workspace-write / danger-full-access
SANDBOX_MODE=workspace-write
# 无人值守环境（MCP server 等）是否允许交互式询问
APPROVAL_INTERACTIVE=true
# 高风险命令是否一律要求批准（workspace-write 下）
APPROVAL_DANGEROUS_REQUIRES=true
# 命令白名单（深度防御）：true = 终端命令只有命中白名单才按原策略放行，
# 未命中的一律升级为需人工批准（never/无人值守下直接拒绝）
APPROVAL_COMMAND_WHITELIST=false
# 追加白名单正则（| 分隔），在内置只读白名单基础上放行项目自有安全命令
# 例如：APPROVAL_COMMAND_WHITELIST_EXTRA=\bpytest\b.*|\bnode\s+build\.js\b
APPROVAL_COMMAND_WHITELIST_EXTRA=
# execpolicy DSL（结构化命令策略，白名单模式的升级）：true = 启用策略文件
# 规则（deny 优先）。安全边界：DSL 评估永远在黑名单与沙箱等级检查之后——
# DSL 不能豁免黑名单，也不能豁免沙箱等级不足，allow 只影响"是否需要询问"。
APPROVAL_EXEC_POLICY_ENABLED=false
# 策略文件路径（规则数组 JSON，格式见 agent/execpolicy.py）。文件缺失/损坏时
# fail-open：规则置空并告警，回到内建策略，不放大权限。
APPROVAL_EXEC_POLICY_FILE=./execpolicy.json

# ---- OS 级沙箱（Windows AppContainer）----
# 沙箱执行模式: off（默认，行为不变）/ appcontainer
# appcontainer = 终端前台命令在 Windows AppContainer 内执行：默认不可访问
# 用户文件/注册表/网络，仅可写工作区。fail-closed：沙箱失败即报错，不回退。
SANDBOX_EXECUTION=off
# 沙箱内命令硬超时秒数
SANDBOX_EXEC_TIMEOUT=120
# AppContainer 档案名（跨会话复用同一容器档案）
SANDBOX_EXEC_PROFILE=my_agent.sandbox
# 启动时给 Python/Node/Git 解释器目录授予容器只读执行权限（icacls
# best-effort）：不授权则沙箱内只能跑系统自带命令（实战验证发现）
SANDBOX_GRANT_TOOLS=true
# 额外只读授权目录清单（; 分隔）：工作区之外的共享库/数据集等只读资源
# 例：SANDBOX_GRANT_DIRS=D:\shared_libs;D:\datasets
SANDBOX_GRANT_DIRS=
# 容器网络放行（默认 false 全禁）：true = 注入 internetClient /
# internetClientServer / privateNetworkClientServer capability，
# 容器内可访问内网/外网（经 Windows 防火墙管控）
SANDBOX_ALLOW_NETWORK=false

# ---- Guardian 安全审校（借鉴同类实现 guardian）----
GUARDIAN_ENABLED=true
GUARDIAN_MIN_RISK=medium
# Guardian 可走独立端点（建议快模型；慢推理模型会触发审校超时）：
#   GUARDIAN_API_KEY=
#   GUARDIAN_BASE_URL=
GUARDIAN_API_KEY=
GUARDIAN_BASE_URL=
GUARDIAN_MODEL=
GUARDIAN_TIMEOUT=20
GUARDIAN_FAIL_OPEN=true

# ---- Rollout 事件追踪（借鉴同类实现 rollout-trace）----
ROLLOUT_ENABLED=true
ROLLOUT_DIR=./rollouts
ROLLOUT_MAX_FILES=20
ROLLOUT_COMPACT_TOKENS=24000
ROLLOUT_KEEP_RECENT=8

# ---- 会话持久化（借鉴同类实现 thread）----
SESSION_ENABLED=true
SESSION_DIR=./memory/sessions
SESSION_MAX=50
# 继续任务时注入上下文的"之前对话"条数（含当前句；实际注入 recent-1 条）
SESSION_CONTEXT_MESSAGES=12
# 每条历史消息注入的最大字符数（防超长回答撑爆上下文）
SESSION_CONTEXT_CHARS=400

# ---- 自我升级安全网 ----
# 运行前 git 快照（SNAPSHOT_ENABLED）；逐操作检查点（CHECKPOINT_PER_TOOL，
# 逐操作式：每次 edit/写文件前 git 快照，可逐操作回滚）
SNAPSHOT_ENABLED=true
CHECKPOINT_PER_TOOL=true

# ---- Repo Map（代码任务时注入仓库结构摘要）----
REPOMAP_ENABLED=true
REPOMAP_MAX_CHARS=3000

# ---- TUI 状态栏 ----
# verbose 模式下每轮模型调用前刷新状态栏（↑输入 ↓输出 token、缓存命中、
# 沙箱等级、审批策略）。false 关闭，只保留运行结束的统计行。
TUI_STATUS_BAR=true

# ---- Team 多Agent协作 ----
# 并行执行独立子任务（true 开启）：Manager 拆解时把不依赖其他子任务结果的
# 子任务标记为 independent；并行前有安全门（参与角色的工具集必须全部并行
# 安全，否则自动回退串行）
TEAM_PARALLEL=false
# 单个并行 Worker 的硬超时秒数（超时标记该子任务失败，不冻结整个团队）
TEAM_WORKER_TIMEOUT=900

# ---- 工具行为 ----
TOOL_OUTPUT_MAX_CHARS=8000
MAX_STEP_OPS=12
# ============ 单循环轮数（动态预算） ============
# 轮数不再是一个固定常数：起步 LOOP_BASE_TURNS 轮，**每出现一轮有进展就续期**
# （改了文件 / 有成功且非重复的操作），连续 LOOP_STALL_LIMIT 轮无进展则提前停。
# 理由：固定上限对简单任务浪费、对复杂任务必然半途被砍（"任务没完成轮数耗尽"）。
# 真正该拦的是空转，不是"轮数多"。判定口径见 agent/loop_budget.py。
LOOP_BASE_TURNS=30
LOOP_EXTEND_PER_PROGRESS=10
LOOP_STALL_LIMIT=5
# 安全网硬上限。留空/注释掉 = 用下面的 MAX_LOOP_OPS 当硬上限；填 0 = 不设绝对上限
# （此时轮数完全由进展与停滞判定决定，只在撞到空转或你按停止时才结束）
# LOOP_HARD_CAP=
# 无限模式下"换了新做法但失败"的轮次不会触发任何停止条件——连续这么多轮无任何进展时
# 向前端发一次"卡了很久"的预警（只预警不自动停；0 = 关闭）。有限模式几乎用不到它。
# LOOP_STAGNATION_WARN=10
# 兼容旧语义的硬上限（默认 80）：只在没配 LOOP_HARD_CAP 时作为安全网生效；
# 显式传 --max-ops N 时则退回"固定 N 轮"的旧行为
MAX_LOOP_OPS=80
# 完成度闸门（"让 agent 做完任务再结束"）：模型给出最终答案时，若它自己的清单
# （会话待办 todo_write / 全局任务板 task）里还有**本次工作产生**的未完成项，
# 就把它推回去继续做完。LOOP_COMPLETION_NUDGES 是推回次数上限——到顶就放行，
# 模型也可以说明"那些项已不需要做"来正常收尾，不会僵持。
LOOP_COMPLETION_GATE=true
LOOP_COMPLETION_NUDGES=2
# ============ Guardian 人工放行（授权）============
# 用户诉求："agent 来求助说某一步被 Guardian 拦截时，我可以跟 Guardian 说放行，
# 或者我跟 agent 说可以执行，agent 拿着这个就能让 Guardian 放行。"
# 防伪是唯一重要的事：授权**只能由人类输入产生**——REPL/CLI 里你亲手敲的那句话，
# 或拦截当场弹窗你答的 y/always。模型输出、工具结果、网页内容永远不会被解析成授权，
# 所以提示注入无法给自己发通行证。授权默认一次性、有有效期，且只跳过 Guardian 盲审
# 这一层（审批硬黑名单与沙箱检查在它之前，授权碰不到）。
GUARDIAN_CONSENT=true
# 授权与被拦记录的有效期（秒），过期自动失效
GUARDIAN_CONSENT_TTL=1800
# 拦截当场就弹窗问人（仅交互式会话；approval=never 或非交互时不弹，拦截保持生效）
GUARDIAN_CONSENT_PROMPT=true
GUARDIAN_CONSENT_MAX_PENDING=5
GUARDIAN_CONSENT_MAX_GRANTS=20
# 单次视觉调用超时（秒）。超时/报错/不支持图片时 → 自动换下面的备用模型
# ⚠️ 超时要按**调用方预算**配：`browser visionclick` 只有 60s，所以
#    VISION_TIMEOUT + 备用链各级的 VISION_FALLBACK_TIMEOUT 之和应 < 60，
#    否则备用即使答出来，那条路径的调用方早已放弃（实测旧配 30+60=90s 就有这个问题；
#    现在 15+20+20=55s，三级全试完仍在预算内——429 会立刻失败，不吃满预算）。
# 实测可用端点是 1-19s 级；若主视觉是内网网关（可能不可达），可再调小，让"网关挂了"
# 快速失败去走备用，而不是每次视觉都白等半分钟。
VISION_TIMEOUT=30
# ============ 备用视觉链（主模型挂了就按顺序换这些）============
# 条目写法（逗号分隔，**顺序即尝试顺序**）：
#   `模型名`         → 用下面这组共享端点（VISION_FALLBACK_BASE_URL / _API_KEY）
#   `模型名@预设名`   → 用该预设自己的端点与 key，预设定义见下（跨厂商必需）
# 推荐顺序：**先同厂商模型级兜底，再跨厂商端点级兜底**——主备同端点时，端点级故障
# （限流、整体变慢）会让两条一起 "Request timed out"，只有跨端点那级救得回来。
# 条目怎么挑：
#   · 先放同厂商的另一个视觉模型（响应快、声明支持 text,image、多图可用）；
#   · 再放跨厂商端点上的模型，作为最后一道兜底（延迟可略高，认字精度要够）；
#   · 自建/内网网关上的模型也可入链（更快、不计费不限流，需网络可达）。
# 与"主端点+主模型"完全相同、或链内重复的条目会被自动跳过（重试同一个东西没意义）。
# ⚠️ 端点与主端点不同的条目，key **必须显式给**：留空是"跟随主 LLM 的 key"，会变成拿
#    A 家 key 打 B 家端点（401）——`my-agent --doctor` 的「子系统模型对账」会抓到。
VISION_FALLBACK_MODELS=<视觉模型 id>,<备用视觉模型 id>@<预设名>
VISION_FALLBACK_BASE_URL=https://<默认端点>/v1
VISION_FALLBACK_API_KEY=
# ---- 命名端点预设：给 `模型@预设名` 用 ----
# 为什么不把 key 写进模型列表：那份列表会被 `/config`、doctor 打印出来，等于把密钥
# 写进日志/终端回滚缓冲。预设名大小写不敏感；名字写错不会报错（视觉 fail-open），
# 而是静默回落到共享端点 —— `--doctor` 会把这种条目当配置错误报出来。
VISION_FALLBACK_ENDPOINT_<预设名>_BASE_URL=https://<备用端点>/v1
VISION_FALLBACK_ENDPOINT_<预设名>_API_KEY=sk-your-key-here
VISION_FALLBACK_TIMEOUT=30

# ============ 备用生图端点（主端点挂了就换这些）============
# 同厂商的多个生图模型通常都可用（返回 b64_json 的端点为佳）。
IMAGE_GEN_FALLBACK_MODELS=<生图模型 id>
IMAGE_GEN_FALLBACK_BASE_URL=https://<默认端点>/v1
IMAGE_GEN_FALLBACK_API_KEY=
IMAGE_GEN_FALLBACK_TIMEOUT=180
# edit 验证式应用：改 .py 后自动跑测试，失败自动回滚并把日志回喂模型（true 开启）
EDIT_PREFLIGHT=false
EDIT_PREFLIGHT_TIMEOUT=180
EDIT_PREFLIGHT_TAIL=80
# preflight 测试范围：related=只跑与被改模块相关的测试（默认，快）
# full=始终跑全套（600+ 个测试，可能超过工具超时导致 edit 误判失败）
EDIT_PREFLIGHT_SCOPE=related
# ============ 任务监管者（独立模型复核"做完没有"）============
# 痛点："让他写小说，它每写一章就来问我一次"。实测根因：单循环唯一的停止条件是
# "模型给出最终回答"，而完成度闸门依赖 agent 自己的清单——最近 8 次运行 todo_write
# 调用数全是 0，闸门从未触发；也没有角色对照**目标**审完成度。
# 监管者 = 一个独立模型，在 agent 想收尾时审"目标做完没有"，没做完就把**下一步指令**
# 发回循环。默认用与主模型不同的厂商：同源自评容易自我确认。
SUPERVISOR_ENABLED=true
SUPERVISOR_MAX_ROUNDS=3
SUPERVISOR_MODEL=<备用模型 id>
SUPERVISOR_BASE_URL=https://<备用端点>/v1
SUPERVISOR_API_KEY=
SUPERVISOR_TIMEOUT=30
# 监管者异常/超时时放行（判完成）：坏掉的裁判不该把任务卡死
SUPERVISOR_FAIL_OPEN=true
# 触发门槛：轮次 ≥1 且目标 ≥12 字才审（一句话问答不惊动它）
SUPERVISOR_MIN_TURNS=1
SUPERVISOR_MIN_GOAL_CHARS=12
# ============ 本地 OCR（截图识字，不依赖视觉模型）============
# 痛点："缺少截图识别文字的能力，总是依赖视觉模型，视觉模型无响应就废了。"
# 视觉模型负责"看懂版面/找元素坐标"，识字这件事本地引擎就能做：快、离线、免费。
# 文字提取默认优先本地 OCR，视觉模型不可用/超时时也自动降级到它。
OCR_ENABLED=true
# 指定后端：windows / rapidocr / tesseract；留空 = 按优先级自动挑
#   windows   = Windows.Media.Ocr（Win10/11 自带，零安装，本机实测支持 zh-Hans-CN）
#   rapidocr  = pip install rapidocr-onnxruntime（跨平台，精度通常更好）
#   tesseract = 需装 tesseract 可执行文件 + pip install pytesseract
OCR_BACKEND=
OCR_LANGUAGES=zh-Hans-CN,en-US
OCR_TIMEOUT=60
# 识别前放大倍数：实测 2 倍对小字号截图更准（约 +2~10 个百分点），3 倍不再提升还更慢
OCR_SCALE=2
# 视觉模型失败/不可用时自动降级到本地 OCR（"就废了"的根治）
OCR_AUTO_FALLBACK=true
# 用户明确要"提取文字/识字"时直接用 OCR，不先问视觉模型
OCR_PREFER_FOR_TEXT=true
# 意图自动路由（--auto-mode 同义）：调研/报告类 → 深度研究；团队/并行类 → 团队模式
AUTO_MODE=false

# ============ 文章工坊（多模型互审写作：/article 或 --article）============
# 为什么跨模型：同一个模型审自己写的稿子，盲点与偏好完全重合，互审会退化成自我复述
# （同厂不同名的模型也基本重合）。默认"主模型写、另一家审"，改这里就能换谁写谁审。
# 端点名与含义见 config.py 的 ARTICLE_ENDPOINTS：main = 主模型（LLM_*），
# 另一个预置端点默认用与主模型不同的厂商。写法："main" / "<端点名>"，或 "<端点名>:<模型名>" 指定具体模型。
ARTICLE_MODEL_OUTLINE=main
ARTICLE_MODEL_DRAFT=main
ARTICLE_MODEL_REVIEW=agnes
ARTICLE_MODEL_CLAIMS=agnes
ARTICLE_MODEL_VERIFY=main
ARTICLE_MODEL_REVISE=main
ARTICLE_MODEL_PROOFREAD=agnes
ARTICLE_MODEL_FINALIZE=main
# 审阅→修订 最多来回几轮（到顶就带剩余意见定稿，不会无限刷 token）
ARTICLE_MAX_REVISE_ROUNDS=2
# 只有这些严重度才回炉重写（轻微问题攒到校对阶段一次性落定）
ARTICLE_REVISE_SEVERITIES=严重,中等
# 先出大纲再写初稿（短文/已有大纲可关掉）
ARTICLE_OUTLINE=true
# 目标篇幅（如 1500字），留空由模型按主题判断
ARTICLE_TARGET_LENGTH=
# 事实核查：只查审阅方点名的可疑说法（全文逐条联网太贵太慢）；
# 需要浏览器（browser 工具）检索，用 DeepResearcher 的轻量检索通道
ARTICLE_FACTCHECK=true
ARTICLE_FACTCHECK_MAX_CLAIMS=5
ARTICLE_LOOKUP_LIMIT=3
# 检索通道（按顺序凑够条数即停）：zhihu=知乎开放平台全网搜索（结构化、稳，
# 需配 ZHIHU_ACCESS_SECRET，5000 次/日）；browser=抓搜索引擎结果页（不需密钥，
# 但实测经常一个来源都取不到）。两条都拿不到才记"未查到"。
ARTICLE_LOOKUP_SOURCES=zhihu,browser
# 限流兜底：一次长文要跑 8+ 个大请求，很容易撞上游 TPM/RPM（实测 revise
# 阶段 429 过）。同一端点退避重试 N 次，仍失败就换另一家端点把这一步跑完
# （fallback=auto 自动选另一家；off 关闭换端点，失败即返回并保留 partial.md）
ARTICLE_STAGE_RETRIES=1
ARTICLE_RETRY_WAIT=20
ARTICLE_FALLBACK_ENDPOINT=auto
# 产物目录（相对路径锚定项目根）
ARTICLE_DIR=./output/articles
# 终端前台命令超时秒数（实战发现 60s 会掐断负载下的全量测试；后台命令不受限）
TERMINAL_FOREGROUND_TIMEOUT=120
# python 代码工具执行超时秒数（exec 无法中断；超时立即返回错误，避免挂到工具级超时）
PYTHON_TOOL_TIMEOUT=30
# 工具执行硬超时（秒）：任何工具超过该时间视为挂起，重置该工具实例防止 Agent 冻结
TOOL_TIMEOUT=300
# 浏览器工具单独超时（秒）：Playwright CDP 挂起高发，设短值更快恢复
BROWSER_TIMEOUT=60
# 循环提示词中引用的测试命令。留空/注释掉 = 按平台自动选
# （Windows 用 .venv\Scripts\python，Linux/Mac 用 .venv/bin/python）
# TEST_COMMAND=.venv\Scripts\python -m pytest tests -q

# ---- AGENTS.md 分层指令（借鉴同类实现 AGENTS.md）----
AGENTS_ENABLED=true
AGENTS_PROJECT_FILE=AGENTS.md
AGENTS_USER_FILE=~/.my_agent/AGENTS.md
AGENTS_MAX_CHARS=20000

# ---- Hooks（工具调用前后回调，fail-open）----
# 开启后按 HOOKS_FILE 加载钩子模块。该模块可定义（均为可选）：
#   def on_pre_tool_use(tool_name, arguments): ...   # 工具执行前
#   def on_post_tool_use(tool_name, result): ...     # 工具执行后
# 文件不存在 / 回调抛异常只记录警告，绝不阻断主流程。
HOOKS_ENABLED=false
HOOKS_FILE=./hooks.py

# ---------- 上下文压缩（compaction） ----------
# 压缩触发阈值：0/未设置 = 自动（按模型窗口 × 比例）；显式数值优先
# COMPACT_TOKEN_THRESHOLD=0
# 自动阈值 = 网关 /models 报告的模型 context_length × 该比例
# COMPACT_WINDOW_RATIO=0.75

# ---------- 桌面操控（computer 工具） ----------
# 无障碍树最大元素数/深度（防止复杂界面拖慢）
COMPUTER_A11Y_MAX_ELEMENTS=120
COMPUTER_A11Y_MAX_DEPTH=8
# 截图保存目录（空 = generated_images/computer/，相对工作目录）
COMPUTER_SCREENSHOT_DIR=

# ---------- Skills 技能包（技能包式能力扩展）----------
# 技能 = 一个包含 SKILL.md 的子目录（项目级 ./skills 与用户级 ~/.my_agent/skills）。
# SKILL.md 头部可选 frontmatter（--- 围栏内 name / description / triggers，
# triggers 为逗号分隔关键词）；缺失或解析失败时降级用目录名。
# 命中 goal 关键词时把技能正文注入系统提示（放在 AGENTS.md 指令之后）。
# SKILLS_ENABLED=true
# SKILLS_DIR=./skills
# SKILLS_USER_DIR=~/.my_agent/skills
# SKILLS_MAX_CHARS=6000

# ---------- MCP 插件（installer 工具安装）----------
# 用户级插件配置落点：Agent 用 installer 工具 mcp_add 安装的服务器写在这里，
# 重启自动恢复连接；一般无需手动改。可覆盖路径：
# MCP_USER_CONFIG_FILE=~/.my_agent/mcp_servers.json
# .env 静态服务器（与用户级插件合并，同名时用户级覆盖）：
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]

# ============ 云经验库（可选） ============
# 私有经验仓（复盘读写；填你的 GitHub 仓库 HTTPS 地址）
# EXPERIENCE_PRIVATE_REPO=
# 公共分享经验仓（只读学习源，可选）
# EXPERIENCE_PUBLIC_REPO=
# EXPERIENCE_BRANCH=main

# ============ 学习 / 经验召回 ============
# 注意区分「库容量」和「召回预算」——早先两者都写死在代码里，且这几个键
# 定义了却没人读，导致经验库实际是"只保留最近 100 条的滑动窗口"、永远长不大。
LEARN_ENABLED=true
# 每次任务往提示词里注入几条经验（召回预算）。调大只影响提示词长度。
LEARN_MAX_RECALL=3
# 经验库容量：默认留 2000 条；填 0 = 不限制（文件留全量）。
# 不建议无脑填 0：experiences.json 每次保存是整体重写，历史越大写盘越慢。
LEARN_MAX_STORE=2000
# 召回打分的候选池：同类别各取最近 N 条参与打分；0 = 全量参与。
# 库留全量后由它压住打分成本（打分是纯字符串运算，200 基本无感）。
LEARN_RECALL_POOL=200
# 失败模式安全阀（按 error_type 去重，天然有界；超限丢最久未见的）
LEARN_MAX_PATTERNS=50
# 是否把失败模式警告注入提示词
LEARN_INJECT_WARNINGS=true

# 会话续跑回忆预算（上轮未完成时自动放宽）
# SESSION_RESUME_CONTEXT_MESSAGES=30
# SESSION_RESUME_CONTEXT_CHARS=600

# 本地工具目录：agent 自己新增的工具放这里（本地技能，不入库）
# LOCAL_TOOLS_ENABLED=true
# LOCAL_TOOLS_DIR=./tools/local


# ============================================================
# 以下为补录：config.py 会读取、但本模板此前漏掉的键
# （AGENTS.md 开发规则 5：新增配置统一放 config.py 并同步 .env.example）
# 值即 config.py 里的默认值；需要改再取消注释。
# ============================================================
# APPROVAL_DECISION_LOG_MAX=200
# APPROVAL_NONINTERACTIVE_ANSWER=deny
# APPROVAL_WORKSPACE_DIR=
# BROWSER_EMBEDDED_AUTO=true
# BROWSER_PERSISTENT=true
# BROWSER_PROFILE_DIR=./memory/browser_profile
# 光标可视化浮层（默认关：点击穿透一旦失效会吞掉整屏鼠标事件，详见 tools/cursor_overlay.py）
# COMPUTER_CURSOR_IDLE=6
# COMPUTER_CURSOR_OVERLAY=false
# COMPUTER_USE_DEFAULT_STEPS=10
# COMPUTER_USE_ENABLED=true
# EXPERIENCE_CACHE_DIR=./memory/experience_lib
# EXPERIENCE_ENABLED=true
# EXPERIENCE_ENTRY_MAX=8000
# EXPERIENCE_LEARN_CHARS=2500
# EXPERIENCE_LEARN_MAX=3
# EXPERIENCE_PULL_TTL=600
# LEARN_DISTILL_API_KEY=
# LEARN_DISTILL_BASE_URL=
# LEARN_DISTILL_MODEL=
# LEARN_DISTILL_PAUSE=0
# LEARN_MIN_GOAL_CHARS=15
# LEARN_MIN_OVERLAP=1
# LEARN_MIN_TOOL_CALLS=2
# MAX_PARALLEL_TOOLS=4
# MCP_ENABLED=true
# MY_AGENT_EMBEDDED_BROWSER_URL=
# ROLLOUT_RESULT_LIMIT=2000
# ROLLOUT_TEXT_LIMIT=4000
# SESSION_WARN_SIZE_MB=20
# SMALL_MODEL=
# SMALL_MODEL_API_KEY=
# SMALL_MODEL_BASE_URL=
# SMALL_MODEL_CHORES=titles
# SMALL_MODEL_ENABLED=true
# SMALL_MODEL_MAX_TOKENS=200
# SMALL_MODEL_TIMEOUT=10
# SMALL_MODEL_TITLE_CHARS=18
# SNAPSHOT_WORK_DIR=
# TTS_TIMEOUT=60
